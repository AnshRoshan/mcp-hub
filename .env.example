# [TEMPLATE]
# ===== MCP Workstation configuration =====
# Copy to .env and fill in the keys for the modules you want.
# Modules whose keys are missing are skipped automatically —
# check `workstation_status` for what's active.

# --- Server ---
PORT=3125
MCP_PATH=/mcp

# ============================================================
# PLATFORM MODE (multi-user: sign-in, dashboard, API tokens)
# ============================================================
# Set BETTER_AUTH_SECRET to turn ON platform mode. When on:
#   - every /mcp request must carry `Authorization: Bearer <api-token>`
#   - a dashboard is served at / with Google/GitHub sign-in
#   - each user registers their own MCP servers (encrypted at rest)
# Generate one with:  openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Public URL clients/browsers use to reach this server.
# (For local use the default http://localhost:PORT is fine.)
# Required when NODE_ENV=production, and must be https:// for any non-local
# host — session cookies and the OAuth issuer are derived from it.
# BETTER_AUTH_URL=http://localhost:3125
# PUBLIC_BASE_URL=http://localhost:3125

# --- OAuth providers (Google + GitHub) ---
# Create a Google OAuth app → https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Create a GitHub OAuth app → https://github.com/settings/developers
#   Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email/password sign-in. OFF by default so a public deploy is not open for
# anyone to register; set true for local development without OAuth providers.
# ALLOW_EMAIL_AUTH=false

# Where the platform DB (users, sessions, servers, tokens) lives.
# PLATFORM_DB=./data/platform.db

# Executables users may register as stdio upstream servers (comma separated,
# bare names only — no paths). The hub spawns these as its own OS user, so the
# default of "none" refuses every user-supplied stdio server. Entries in
# config/servers.json are operator-owned and unaffected by this list.
# STDIO_ALLOWED_COMMANDS=npx,uvx

# Extra origins allowed to call the auth API (comma separated), if any.
# TRUSTED_ORIGINS=

# Better Auth's own logger. OFF by default. Its output can contain session
# tokens, so this is for local debugging only — NEVER enable it on a deployed
# instance. (src/platform/auth.ts)
# AUTH_DEBUG=true

# NODE_ENV only matters in platform mode: with NODE_ENV=production the server
# refuses to start unless BETTER_AUTH_URL (or PUBLIC_BASE_URL) is set, because
# the session-cookie `secure` flag and the OAuth issuer are derived from it.
# NODE_ENV=production

# --- Core modules (no keys needed) ---
# Root folders the filesystem tools may touch (comma separated).
FILESYSTEM_ROOTS=./data/workspace
# Where the memory module persists data.
MEMORY_FILE=./data/memory.json
# Where the knowledge base (full-text + vector search) stores its index.
# KNOWLEDGE_DB=./data/knowledge.db

# --- GitHub (built-in module — server-level key shared with all users) ---
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Optional: point at a GitHub Enterprise Server instance.
# GITHUB_API_URL=https://github.example.com/api/v3

# --- Jira (built-in module) ---
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxx   (API token or PAT)
# JIRA_EMAIL=you@example.com           (required for API-token basic auth; omit for PAT)

# --- Web search (enable any one) ---
# BRAVE_API_KEY=BSAxxxxxxxxxxxxxxxx
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
# EXA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Outbound requests (fetch_url, web_search / web_extract) ---
# Every caller-supplied URL is screened first: http(s) only, no embedded
# credentials, and hosts that resolve to loopback / private / link-local (cloud
# metadata) or other reserved ranges are refused, re-checked on every redirect.
# That baseline cannot be turned off. This variable only narrows it further:
# when set, ONLY these hostnames or suffixes may be fetched (a caller's own
# allowed_domains argument can restrict more, never widen this list).
# Comma separated. Unset = any public host.
# FETCH_ALLOWED_DOMAINS=api.github.com,.example.com

# --- Databases ---
# DATABASE_URL=postgres://user:pass@localhost:5432/mydb
# PG_ALLOW_WRITE=true
# SQLITE_PATH=./data/workstation.db
# SQLITE_ALLOW_WRITE=true

# --- Productivity ---
# NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx
# SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Upstream MCP servers to aggregate (shared with all users) ---
# Path to a JSON file listing extra MCP servers (stdio or HTTP) to proxy.
# MCP_WORKSTATION_SERVERS=./config/servers.json

# Per-tool-call timeout for upstream servers (default 60s).
# UPSTREAM_CALL_TIMEOUT_MS=60000
# Max response size in bytes from upstream servers (default 10MB).
# UPSTREAM_MAX_RESPONSE_BYTES=10485760

# ============================================================
# RATE LIMITING
# ============================================================
# Per-user rate limiting on tool calls. ON by default in platform mode (a
# shared gateway), off for single-user local runs.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=60          # max calls per window per tool per user
# RATE_LIMIT_WINDOW_MS=60000     # window size in ms (default 1 minute)

# ============================================================
# AUDIT LOGGING
# ============================================================
# Structured audit logging for every tool call (correlation IDs, latency, etc.).
# AUDIT_LOG_ENABLED=true
# AUDIT_LOG_FORMAT=json          # json or text
# AUDIT_LOG_MASK_ARGS=false      # mask sensitive arg values in logs

# ============================================================
# HEALTH CHECKS
# ============================================================
# Periodic health checks for upstream MCP servers with auto-reconnect.
# HEALTHCHECK_ENABLED=true
# HEALTHCHECK_INTERVAL_MS=60000  # probe interval (default 1 min)
# HEALTHCHECK_TIMEOUT_MS=10000   # per-probe timeout
# HEALTHCHECK_MAX_BACKOFF_MS=300000  # max reconnect backoff (default 5 min)

# ============================================================
# CORS (platform/dashboard mode)
# ============================================================
# /mcp is Bearer-token gated and always allows any origin. The cookie-gated
# /api/* routes only accept these comma-separated origins for credentialed
# cross-origin calls (e.g. a dashboard served from a different host).
# Leave unset for same-origin-only, which is the secure default.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# ============================================================
# PER-USER UPSTREAM CONNECTIONS (platform mode)
# ============================================================
# Each user's enabled upstream servers get a pooled connection that's evicted
# when idle or when the cache is full (LRU).
# USER_SESSION_TTL_MS=900000     # idle time before a user's connections close (default 15 min)
# MAX_USER_SESSIONS=50           # most-recently-used cap on concurrently-connected users

# ============================================================
# LITE CATALOG & RESULT GUARDRAILS
# ============================================================
# Lite mode is a per-user preference (dashboard: Modules → Lite catalog;
# API: PUT /api/prefs {"liteCatalog":true}). New platform users default to ON.
# Oversized tool results are spilled to <first FILESYSTEM_ROOT>/results/<id>.json
# with a preview + fs_read pointer. 0 disables spilling.
# MAX_RESULT_BYTES=200000

# Largest request body the /api, /api/auth and /oauth routes will buffer
# (413 beyond this). Guards against a client streaming an unbounded body.
# MAX_REQUEST_BYTES=8388608

# Ceiling on a caller-supplied regex before it is killed. Both run on a worker
# thread that gets terminated, because a catastrophic pattern ((a+)+$ on a long
# near-miss) spins inside a single step and would otherwise freeze every user.
# REGEX_TIMEOUT_MS=2000        # regex_test
# FS_SEARCH_TIMEOUT_MS=5000    # fs_search
