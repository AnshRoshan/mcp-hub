{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    // vite/client for import.meta/env, node because `include` covers
    // vite.config.ts, which imports node:path and reads import.meta.dirname.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
